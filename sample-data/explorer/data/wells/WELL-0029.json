L-0029/2026-10-15_thermal.jpg"]}],"maintenance":[{"id":"MNT-0029-001","started_at":"2025-01-25T08:00:00Z","completed_at":"2025-01-25T15:00:00Z","type":"scheduled","equipment":"wellhead","issue":"Scheduled wellhead valve service","action":"Valves serviced and pressure tested","technician_id":"U-305","technician":"Megan Ward","contractor":"Coyote Ridge Well Services","downtime_hours":7,"cost":807,"labor":347,"parts":460,"triggered_by":null,"report_html":null},{"id":"MNT-0029-002","started_at":"2025-03-29T08:00:00Z","completed_at":"2025-03-29T14:00:00Z","type":"scheduled","equipment":"flowline","issue":"Annual flowline integrity test","action":"Integrity test passed","technician_id":"U-303","technician":"Kevin Price","contractor":"Tumbleweed Flowline Co.","downtime_hours":6,"cost":1220,"labor":505,"parts":715,"triggered_by":null,"report_html":null},{"id":"MNT-0029-003","started_at":"2025-05-17T08:00:00Z","completed_at":"2025-05-17T10:00:00Z","type":"scheduled","equipment":"pump_jack","issue":"Scheduled lubrication and belt inspection","action":"Lubricated, belts tensioned","technician_id":"U-303","technician":"Kevin Price","contractor":null,"downtime_hours":2,"cost":681,"labor":256,"parts":425,"triggered_by":null,"report_html":null},{"id":"MNT-0029-004","started_at":"2025-07-12T08:00:00Z","completed_at":"2025-08-20T02:00:00Z","type":"corrective","equipment":"downhole_pump","issue":"Downhole pump stuck","action":"Pulled and replaced downhole pump","technician_id":"U-302","technician":"Daniel Foster","contractor":"Sandstone Rod & Pump","downtime_hours":930,"cost":32155,"labor":16832,"parts":15323,"triggered_by":"INS-0029-0025","report_html":"<h1>Maintenance Report \u2014 MNT-0029-004</h1>\n<p><strong>Asset:</strong> WELL-0029 (SW-23 Well 029, T350, Southwest Block 23) <strong>Equipment:</strong> downhole pump <strong>Work started:</strong> 12 Jul 2025 08:00 \u00b7 <strong>Finished:</strong> 20 Aug 2025 02:00 \u00b7 <strong>Well stopped for this job:</strong> 930 hours <strong>Crew lead:</strong> Daniel Foster (U-302) \u00b7 <strong>Crew:</strong> Brian Coleman \u00b7 <strong>Contractor:</strong> Sandstone Rod &amp; Pump <strong>Triggered by:</strong> inspection INS-0029-0025 on 2025-07-10 <strong>Report written:</strong> 21 Aug 2025</p>\n<h2>What happened</h2>\n<p>Field staff reported that fluid stopped reaching the flowline and the rod load spiked on the downstroke. The thermal reading at inspection INS-0029-0025 showed the wellhead at 42.7 \u00b0C with the air at 34.3 \u00b0C, so the well was not producing. The operator shut the well in for the repair. The downhole pump was stuck, most likely from sand or scale. Sandstone Rod &amp; Pump&#x27;s workover rig was busy on other wells, so the well waited about 37 days for it; the work itself took about 2 days.</p>\n<h2>Root cause</h2>\n<p>Sand and scale build-up in the pump barrel.</p>\n<h2>Safety and permits</h2>\n<ul><li>Pre-job safety meeting held with the crew before work started (WS-01).</li><li>Energy isolated: prime mover stopped at the bottom of the stroke, brake set and chained, motor disconnect locked and tagged, wellhead wing valve closed and tagged, pressure bled off (WS-02).</li><li>Personal H2S monitors worn; highest reading 3 ppm, below the 10 ppm stop-work level (WS-03).</li></ul>\n<h2>Work done</h2>\n<ol><li>Rigged up the company workover rig on the well.</li><li>Pulled the rods and the insert pump.</li><li>Inspected the pump: sand in the barrel and a worn plunger.</li><li>Ran in a new insert pump.</li><li>Re-spaced the pump and hung the rods back on.</li></ol>\n<p>Summary of the fix: pulled and replaced downhole pump.</p>\n<h2>Testing and return to service</h2>\n<p>Pump test confirmed fluid to surface and the wellhead warmed back to normal. The well was returned to production.</p>\n<h2>Parts and cost</h2>\n<table><thead><tr><th>Item</th><th>USD</th></tr></thead><tbody><tr><td>Insert rod pump</td><td>9,960</td></tr><tr><td>Rig services</td><td>3,831</td></tr><tr><td>Consumables</td><td>1,532</td></tr><tr><td>Labour (company crew and contractor)</td><td>16,832</td></tr><tr><td><strong>Total</strong></td><td><strong>32,155</strong></td></tr></tbody></table>\n<h2>Compliance check</h2>\n<table><thead><tr><th>Protocol</th><th>Result</th><th>Detail</th></tr></thead><tbody><tr><td>WS-01</td><td>Met</td><td>Meeting held and recorded</td></tr><tr><td>WS-02</td><td>Met</td><td>Energy isolated and tagged</td></tr><tr><td>WS-03</td><td>Met</td><td>Monitors bump-tested; highest 3 ppm</td></tr><tr><td>WS-07</td><td>Met</td><td>Written 1 day after the work (limit 3 days)</td></tr></tbody></table>\n<h2>Notes and recommendations</h2>\n<ul><li>Review sand control on this well.</li><li>Send the old pump for teardown.</li></ul>"},{"id":"MNT-0029-005","started_at":"2025-07-13T08:00:00Z","completed_at":"2025-07-13T12:00:00Z","type":"scheduled","equipment":"wellhead","issue":"Scheduled wellhead valve service","action":"Valves serviced and pressure tested","technician_id":"U-305","technician":"Megan Ward","contractor":"Coyote Ridge Well Services","downtime_hours":4,"cost":1369,"labor":452,"parts":917,"triggered_by":null,"report_html":null},{"id":"MNT-0029-006","started_at":"2025-09-28T08:00:00Z","completed_at":"2025-09-28T13:00:00Z","type":"scheduled","equipment":"wellhead","issue":"Scheduled wellhead valve service","action":"Valves serviced and pressure tested","technician_id":"U-305","technician":"Megan Ward","contractor":"Coyote Ridge Well Services","downtime_hours":5,"cost":1352,"labor":648,"parts":704,"triggered_by":null,"report_html":null},{"id":"MNT-0029-007","started_at":"2025-12-13T08:00:00Z","completed_at":"2025-12-13T10:00:00Z","type":"scheduled","equipment":"wellhead","issue":"Scheduled wellhead valve service","action":"Valves serviced and pressure tested","technician_id":"U-304","technician":"Brian Coleman","contractor":null,"downtime_hours":2,"cost":840,"labor":270,"parts":570,"triggered_by":null,"report_html":null},{"id":"MNT-0029-008","started_at":"2026-02-28T08:00:00Z","completed_at":"2026-02-28T13:00:00Z","type":"scheduled","equipment":"pump_jack","issue":"Scheduled lubrication and belt inspection","action":"Lubricated, belts tensioned","technician_id":"U-304","technician":"Brian Coleman","contractor":"Coyote Ridge Well Services","downtime_hours":5,"cost":849,"labor":427,"parts":422,"triggered_by":null,"report_html":null},{"id":"MNT-0029-009","started_at":"2026-04-24T08:00:00Z","completed_at":"2026-04-24T10:00:00Z","type":"scheduled","equipment":"wellhead","issue":"Scheduled wellhead valve service","action":"Valves serviced and pressure tested","technician_id":"U-303","technician":"Kevin Price","contractor":"Coyote Ridge Well Services","downtime_hours":2,"cost":658,"labor":347,"parts":311,"triggered_by":null,"report_html":null},{"id":"MNT-0029-010","started_at":"2026-05-15T08:00:00Z","completed_at":"2026-05-15T18:00:00Z","type":"corrective","equipment":"flowline","issue":"Flowline leak causing spill","action":"Replaced leaking flowline section and remediated soil","technician_id":"U-305","technician":"Megan Ward","contractor":null,"downtime_hours":10,"cost":4517,"labor":2465,"parts":2052,"triggered_by":"INS-0029-0068","report_html":"<h1>Maintenance Report \u2014 MNT-0029-010</h1>\n<p><strong>Asset:</strong> WELL-0029 (SW-23 Well 029, T350, Southwest Block 23) <strong>Equipment:</strong> flowline <strong>Work started:</strong> 15 May 2026 08:00 \u00b7 <strong>Finished:</strong> 15 May 2026 18:00 \u00b7 <strong>Well stopped for this job:</strong> 10 hours <strong>Crew lead:</strong> Megan Ward (U-305) \u00b7 <strong>Crew:</strong> Kevin Price, Daniel Foster <strong>Triggered by:</strong> inspection INS-0029-0068 on 2026-05-14 <strong>Report written:</strong> 16 May 2026</p>\n<h2>What happened</h2>\n<p>The weekly manual inspection INS-0029-0068 at 08:15 on 2026-05-14 found crude oil on the pad: about 10.7% of the pad area, estimated 3.5 bbl. The inspector noted: &quot;Pooled fluid near flowline.&quot; The field operator shut the well in, closed the flowline valve and placed earth berms and absorbent pads. The release was contained about 1.9 hours after the inspection. The crew traced the leak to a threaded coupling on the flowline close to the wellhead.</p>\n<h2>Root cause</h2>\n<p>Corrosion under a failed protective wrap on the coupling.</p>\n<h2>Safety and permits</h2>\n<ul><li>Pre-job safety meeting held with the crew before work started (WS-01).</li><li>Energy isolated: prime mover stopped at the bottom of the stroke, brake set and chained, motor disconnect locked and tagged, wellhead wing valve closed and tagged, pressure bled off (WS-02).</li><li>Personal H2S monitors worn; highest reading 0 ppm, below the 10 ppm stop-work level (WS-03).</li><li>Hot work permit issued for welding; gas test before welding read 0% LEL, below the 10% limit (WS-04).</li></ul>\n<h2>Work done</h2>\n<ol><li>Excavated around the coupling.</li><li>Cut out the failed coupling and the pipe ends.</li><li>Welded in new pipe and a new fitting.</li><li>Coated the new joints.</li><li>Excavated the stained soil.</li><li>Backfilled after the pressure test.</li></ol>\n<p>Summary of the fix: replaced leaking flowline section and remediated soil.</p>\n<h2>Testing and return to service</h2>\n<p>Pressure-tested the repaired section at 300 psi (1.25 \u00d7 the flowline&#x27;s maximum operating pressure of 240 psi) and held it for 4 hours with no pressure drop (WS-05). The well was returned to production.</p>\n<h2>Spill clean-up and waste</h2>\n<ul><li>About 3.7 m\u00b3 of stained soil excavated, bagged and sent to an approved disposal site under waste manifest WM-0029-010 (WS-06).</li><li>2 soil samples taken around the spill; the highest result after clean-up was 0.44% TPH, below the 1.0% target (SR-03).</li></ul>\n<h2>Parts and cost</h2>\n<table><thead><tr><th>Item</th><th>USD</th></tr></thead><tbody><tr><td>Line pipe and fittings</td><td>923</td></tr><tr><td>Absorbents and berms</td><td>410</td></tr><tr><td>Soil hauling and disposal</td><td>719</td></tr><tr><td>Labour (company crew)</td><td>2,465</td></tr><tr><td><strong>Total</strong></td><td><strong>4,517</strong></td></tr></tbody></table>\n<h2>Compliance check</h2>\n<table><thead><tr><th>Protocol</th><th>Result</th><th>Detail</th></tr></thead><tbody><tr><td>WS-01</td><td>Met</td><td>Meeting held and recorded</td></tr><tr><td>WS-02</td><td>Met</td><td>Energy isolated and tagged</td></tr><tr><td>WS-03</td><td>Met</td><td>Monitors bump-tested; highest 0 ppm</td></tr><tr><td>WS-04</td><td>Met</td><td>Permit issued; gas test 0% LEL</td></tr><tr><td>WS-05</td><td>Met</td><td>Tested at 1.25 \u00d7 maximum operating pressure, held 4 hours</td></tr><tr><td>WS-06</td><td>Met</td><td>Oily waste manifested to an approved site</td></tr><tr><td>WS-07</td><td>Met</td><td>Written 1 day after the work (limit 3 days)</td></tr><tr><td>SR-02</td><td>Met</td><td>Contained about 1.9 hours after discovery (limit 4 hours)</td></tr><tr><td>SR-04</td><td>Met</td><td>Spill recorded with volume and area (moderate class)</td></tr><tr><td>HSE notice</td><td>Met</td><td>HSE notified 7 hours after discovery (company limit 72 hours for moderate spills)</td></tr><tr><td>SR-03</td><td>Met</td><td>Cleaned to below 1.0% TPH; agency verification applies only to reportable spills</td></tr></tbody></table>\n<h2>Notes and recommendations</h2>\n<ul><li>Inspect the remaining joints on this flowline.</li><li>Record the leak location for the flowline maintenance program (RC-05).</li></ul>"},{"id":"MNT-0029-011","started_at":"2026-05-30T08:00:00Z","completed_at":"2026-05-30T12:00:00Z","type":"scheduled","equipment":"flowline","issue":"Annual flowline integrity test","action":"Integrity test passed","technician_id":"U-304","technician":"Brian Coleman","contractor":null,"downtime_hours":4,"cost":2008,"labor":891,"parts":1117,"triggered_by":null,"report_html":null},{"id":"MNT-0029-012","started_at":"2026-07-18T08:00:00Z","completed_at":"2026-07-1