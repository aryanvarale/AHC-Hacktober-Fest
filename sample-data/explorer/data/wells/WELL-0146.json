ctor":"Tyler Hughes","method":"drone","ambient_c":20.8,"wellhead_c":52.6,"delta_c":31.8,"producing":true,"alarm":false,"spill":false,"spill_area_pct":null,"spill_bbl":null,"spill_class":null,"corrected":false,"notes":"","evidence":["evidence/WELL-0146/2026-10-15_rgb.jpg","evidence/WELL-0146/2026-10-15_thermal.jpg"]}],"maintenance":[{"id":"MNT-0146-001","started_at":"2024-12-22T08:00:00Z","completed_at":"2024-12-22T16:00:00Z","type":"scheduled","equipment":"pump_jack","issue":"Scheduled lubrication and belt inspection","action":"Lubricated, belts tensioned","technician_id":"U-302","technician":"Daniel Foster","contractor":null,"downtime_hours":8,"cost":320,"labor":168,"parts":152,"triggered_by":null,"report_html":null},{"id":"MNT-0146-002","started_at":"2025-03-08T08:00:00Z","completed_at":"2025-03-08T12:00:00Z","type":"scheduled","equipment":"pump_jack","issue":"Scheduled lubrication and belt inspection","action":"Lubricated, belts tensioned","technician_id":"U-303","technician":"Kevin Price","contractor":null,"downtime_hours":4,"cost":311,"labor":149,"parts":162,"triggered_by":null,"report_html":null},{"id":"MNT-0146-003","started_at":"2025-03-08T08:00:00Z","completed_at":"2025-03-08T16:00:00Z","type":"scheduled","equipment":"flowline","issue":"Annual flowline integrity test","action":"Integrity test passed","technician_id":"U-303","technician":"Kevin Price","contractor":null,"downtime_hours":8,"cost":1463,"labor":786,"parts":677,"triggered_by":null,"report_html":null},{"id":"MNT-0146-004","started_at":"2025-05-16T08:00:00Z","completed_at":"2025-06-25T06:00:00Z","type":"corrective","equipment":"wellhead","issue":"Stuffing box packing leak","action":"Replaced stuffing box packing","technician_id":"U-303","technician":"Kevin Price","contractor":"Coyote Ridge Well Services","downtime_hours":958,"cost":716,"labor":306,"parts":410,"triggered_by":"INS-0146-0022","report_html":"<h1>Maintenance Report \u2014 MNT-0146-004</h1>\n<p><strong>Asset:</strong> WELL-0146 (NE-07 Well 146, T200, Northeast Block 7) <strong>Equipment:</strong> wellhead <strong>Work started:</strong> 16 May 2025 08:00 \u00b7 <strong>Finished:</strong> 25 Jun 2025 06:00 \u00b7 <strong>Well stopped for this job:</strong> 958 hours <strong>Crew lead:</strong> Kevin Price (U-303) \u00b7 <strong>Crew:</strong> Daniel Foster \u00b7 <strong>Contractor:</strong> Coyote Ridge Well Services <strong>Triggered by:</strong> inspection INS-0146-0022 on 2025-05-15 <strong>Report written:</strong> 27 Jun 2025</p>\n<h2>What happened</h2>\n<p>Field staff reported that the inspector saw a thin film of oil on the wellhead. The thermal reading at inspection INS-0146-0022 showed the wellhead at 31.6 \u00b0C with the air at 32.3 \u00b0C, so the well was not producing. The operator shut the well in for the repair. The packing rings were worn and the polished rod was lightly scored. The well stayed shut in for about 38 days longer than the repair itself because the crew was committed to a higher-priority spill response elsewhere in the field.</p>\n<h2>Root cause</h2>\n<p>Normal packing wear.</p>\n<h2>Safety and permits</h2>\n<ul><li>Pre-job safety meeting held with the crew before work started (WS-01).</li><li>Energy isolated: prime mover stopped at the bottom of the stroke, brake set and chained, motor disconnect locked and tagged, wellhead wing valve closed and tagged, pressure bled off (WS-02).</li><li>Personal H2S monitors worn; highest reading 4 ppm, below the 10 ppm stop-work level (WS-03).</li></ul>\n<h2>Work done</h2>\n<ol><li>Closed the wellhead valves and bled off pressure.</li><li>Removed the old packing.</li><li>Installed new packing rings and adjusted the gland.</li><li>Cleaned the wellhead area.</li></ol>\n<p>Summary of the fix: replaced stuffing box packing.</p>\n<h2>Testing and return to service</h2>\n<p>Checked the stuffing box with the unit running: no leak. The well was returned to production.</p>\n<h2>Parts and cost</h2>\n<table><thead><tr><th>Item</th><th>USD</th></tr></thead><tbody><tr><td>Stuffing box packing set</td><td>287</td></tr><tr><td>Absorbent pads</td><td>123</td></tr><tr><td>Labour (company crew and contractor)</td><td>306</td></tr><tr><td><strong>Total</strong></td><td><strong>716</strong></td></tr></tbody></table>\n<h2>Compliance check</h2>\n<table><thead><tr><th>Protocol</th><th>Result</th><th>Detail</th></tr></thead><tbody><tr><td>WS-01</td><td>Met</td><td>Meeting held and recorded</td></tr><tr><td>WS-02</td><td>Met</td><td>Energy isolated and tagged</td></tr><tr><td>WS-03</td><td>Met</td><td>Monitors bump-tested; highest 4 ppm</td></tr><tr><td>WS-07</td><td>Met</td><td>Written 2 days after the work (limit 3 days)</td></tr></tbody></table>\n<h2>Notes and recommendations</h2>\n<ul><li>Check the polished rod for wear at the next service.</li></ul>"},{"id":"MNT-0146-005","started_at":"2025-06-28T08:00:00Z","completed_at":"2025-06-28T13:00:00Z","type":"scheduled","equipment":"pump_jack","issue":"Scheduled lubrication and belt inspection","action":"Lubricated, belts tensioned","technician_id":"U-303","technician":"Kevin Price","contractor":"Coyote Ridge Well Services","downtime_hours":5,"cost":688,"labor":327,"parts":361,"triggered_by":null,"report_html":null},{"id":"MNT-0146-006","started_at":"2025-10-12T08:00:00Z","completed_at":"2025-10-12T17:00:00Z","type":"scheduled","equipment":"pump_jack","issue":"Scheduled lubrication and belt inspection","action":"Lubricated, belts tensioned","technician_id":"U-302","technician":"Daniel Foster","contractor":"Coyote Ridge Well Services","downtime_hours":9,"cost":757,"labor":306,"parts":451,"triggered_by":null,"report_html":null},{"id":"MNT-0146-007","started_at":"2026-01-30T08:00:00Z","completed_at":"2026-01-30T12:00:00Z","type":"scheduled","equipment":"wellhead","issue":"Scheduled wellhead valve service","action":"Valves serviced and pressure tested","technician_id":"U-302","technician":"Daniel Foster","contractor":"Coyote Ridge Well Services","downtime_hours":4,"cost":1159,